# Vayyl Vault V2 - testnet deployment
# Source of truth: deployments/testnet-vault-v2.json at repo root.
# Copy to `.env.local` before `pnpm dev` / `pnpm build`.
#
# Stack redeployed 2026-08-02 with `deployer` as admin, then upgraded in place
# for transfer_v2 (contract IDs unchanged by the upgrade).
# Registered VKs: Deposit 2, Withdraw 3, Transfer 5 public inputs.

NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Indexer and relayer are NOT hosted right now - the former Railway deployments
# are gone (DNS no longer resolves). Run both locally:
#   backend/indexer  -> pnpm dev  (port 3001)
#   backend/relayer  -> pnpm dev  (port 3002)
# Both read the pool address from their own .env; keep them on the pool below.
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
NEXT_PUBLIC_RELAYER_URL=http://localhost:3002

# Relayer SET. A single relayer means every withdrawal shares one fee payer,
# which clusters the whole user base without touching the cryptography. The
# client picks uniformly at random per request. Falls back to the single URL
# above when unset. See RELAYERS.md.
# NEXT_PUBLIC_RELAYER_SET=https://relayer-a.example,https://relayer-b.example

# Randomised hold before a withdrawal is submitted. A fixed gap between deposit
# and withdrawal is the same weakness as a shared fee payer on another axis.
# A delay only mixes if other transactions land inside the window.
NEXT_PUBLIC_WITHDRAW_DELAY_MIN_MS=30000
NEXT_PUBLIC_WITHDRAW_DELAY_MAX_MS=600000

NEXT_PUBLIC_POOL_XLM=CB6XFHGN4DMVEQRESJHPOUNYLUCGMOZTAIKTWH3I7KT3NVW2XY4NIOLC
NEXT_PUBLIC_VERIFIER=CBRMDGEMQERFTG3MCBHYPHMZPKVMDYFGHJAMREQW23ZDKVAMAFDRJ2J5
